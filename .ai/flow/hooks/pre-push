#!/usr/bin/env bash
# crewlead pre-push hook — the machine-side stand-in for branch protection
# (GitHub Free has none on private repos). Blocks, for people and agents alike:
#   - any push to main, master, or the project's default_branch
#     (.ai/project.yml, e.g. develop)
#   - any force push (remote branch not an ancestor of what is pushed)
# A person who really means it: ALLOW_PUSH_TO_MAIN=1 / ALLOW_FORCE_PUSH=1.
# Agents are forbidden to set either (AGENTS.md §6).
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0

top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
default_branch="$(sed -n "s/^default_branch:[[:space:]]*['\"]\{0,1\}\([^'\" #]*\).*/\1/p" "$top/.ai/project.yml" 2>/dev/null | head -1 || true)"
default_ref="refs/heads/${default_branch:-main}"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|"$default_ref")
      if [[ "${ALLOW_PUSH_TO_MAIN:-}" != "1" ]]; then
        echo "crewlead: push to ${remote_ref#refs/heads/} blocked — open a PR instead." >&2
        echo "             (a person who really means it: ALLOW_PUSH_TO_MAIN=1 git push …)" >&2
        status=1
      fi
      ;;
  esac
  if [[ "$local_sha" != "$zero" && "$remote_sha" != "$zero" ]] \
     && git cat-file -e "$remote_sha" 2>/dev/null \
     && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    if [[ "${ALLOW_FORCE_PUSH:-}" != "1" ]]; then
      echo "crewlead: force push to ${remote_ref#refs/heads/} blocked — add commits instead of rewriting history." >&2
      status=1
    fi
  fi
done

exit "$status"
